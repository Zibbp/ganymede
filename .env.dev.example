# Development defaults for running Ganymede natively on the host with mise.
# `mise run setup` copies this to .env when .env does not exist. .env is
# gitignored; edit your copy freely.

# Data directories, relative to the repository root. Both host processes and
# the compose worker resolve them against the repo (the worker bind-mounts it
# at /workspace), so the host server and container worker agree on the paths
# stored in the database.
VIDEOS_DIR=dev/videos
TEMP_DIR=dev/temp
LOGS_DIR=dev/logs
CONFIG_DIR=dev/config

TZ=America/Chicago
DEBUG=false

# Compose database from `mise run db`, published on 127.0.0.1:5432. Container
# services (devcontainer, compose worker) override DB_HOST themselves.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ganymede
DB_PASS=ganymede
DB_NAME=ganymede
DB_SSL=disable

# Required: the server refuses to start without Twitch credentials.
# Create an application at https://dev.twitch.tv/console/apps/create
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Used by the frontend dev server (mise run web) to reach the host API server.
API_URL=http://localhost:4000
