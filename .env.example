# Copy to .env and edit for your installation. Relative host paths are
# resolved from the Compose project directory.
VIDEOS_HOST_DIR=/path/to/vod/storage
TEMP_HOST_DIR=./temp
LOGS_HOST_DIR=./logs
CONFIG_HOST_DIR=./config
DB_HOST_DIR=./ganymede-db

# Container paths must match the volume mounts.
VIDEOS_DIR=/data/videos
TEMP_DIR=/data/temp
LOGS_DIR=/data/logs
CONFIG_DIR=/data/config

TZ=America/Chicago
DEBUG=false
# SKIP_CHOWN=true
# PUID=911
# PGID=911

# Shared by Ganymede and the bundled PostgreSQL service.
DB_HOST=ganymede-db
DB_PORT=5432
DB_USER=ganymede
DB_PASS=PASSWORD
DB_NAME=ganymede-prd
DB_SSL=disable
# DB_SSL_ROOT_CERT= # path to cert in the container if DB_SSL is not disabled
# DB_MAX_CONNS=0 # optional cap per Postgres pool; 0/unset = library defaults, else min 2; total can reach 4 x value + 1

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional worker settings (defaults shown).
# MAX_CHAT_DOWNLOAD_EXECUTIONS=3
# MAX_CHAT_RENDER_EXECUTIONS=2
# MAX_VIDEO_DOWNLOAD_EXECUTIONS=2
# MAX_VIDEO_CONVERT_EXECUTIONS=3
# MAX_VIDEO_SPRITE_THUMBNAIL_EXECUTIONS=2
# DISABLE_LIVE_ARCHIVE_STALL_CHECK=false
# LIVE_ARCHIVE_STALL_TIMEOUT_SECONDS=180

# Optional OAuth and frontend settings.
# OAUTH_ENABLED=false
# OAUTH_PROVIDER_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URL=http://IP:PORT/api/v1/auth/oauth/callback
SHOW_SSO_LOGIN_BUTTON=true
FORCE_SSO_AUTH=false
REQUIRE_LOGIN=false
# CDN_URL=
